enum Role {
  SUPPLIER
  USER
  ADMIN
  SUPERADMIN
}

enum PaymentMethod {
  WEBPAY
  PAYPAL
}

enum PaymentStatus {
  PENDING
  PAID
  REJECTED
  CANCELLED
}

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id_user        String           @id @default(cuid())
  email          String           @unique
  phone_number   String?
  firstName      String
  lastName       String
  password       String
  birthDate      DateTime?        @db.Date
  role           Role             @default(USER)
  address        Address[]
  orders         Order[]
  AIConversation AIConversation[]
  AIUserMemory   AIUserMemory[]
}

model Supplier {
  id_supplier  String    @id @default(cuid())
  name         String    @unique
  email        String    @unique
  phone_number String    @unique
  role         Role      @default(SUPPLIER)
  address      Address[]
  products     Product[]
}

model Address {
  id_address   String  @id @default(cuid())
  street       String
  house_number String
  department   String?
  block        String?
  comune       String
  region       String
  reference    String?

  id_supplier String?
  id_user     String?

  user     User?     @relation(fields: [id_user], references: [id_user])
  supplier Supplier? @relation(fields: [id_supplier], references: [id_supplier])
}

model Category {
  id_category String    @id @default(cuid())
  name        String    @unique
  description String?
  products    Product[]
}

model Brand {
  id_brand       String    @id @default(cuid())
  name           String    @unique
  country_origin String?
  products       Product[]
}

model Product {
  id_product  String @id @default(cuid())
  id_supplier String
  id_category String
  id_brand    String
  photo_path  String?
  sku         String   @unique
  name        String
  model       String
  material    String?
  weight      Decimal? @db.Decimal(10, 3)
  price       Int
  description String?
  stock       Int

  embedding Unsupported("vector")?

  supplier     Supplier      @relation(fields: [id_supplier], references: [id_supplier])
  category     Category      @relation(fields: [id_category], references: [id_category])
  brand        Brand         @relation(fields: [id_brand], references: [id_brand])
  detailOrders DetailOrder[]
}

model Order {
  id_order String        @id @default(cuid())
  id_user  String
  date     DateTime      @default(now())
  total    Int
  method   PaymentMethod
  status   PaymentStatus @default(PENDING)

  user         User          @relation(fields: [id_user], references: [id_user])
  detailOrders DetailOrder[]
}

model DetailOrder {
  id_detail  String @id @default(cuid())
  id_order   String
  id_product String
  amount     Int
  unit_price Int

  order   Order   @relation(fields: [id_order], references: [id_order])
  product Product @relation(fields: [id_product], references: [id_product])
}

model AIConversation {
  id_conversation String   @id @default(cuid())
  id_user         String
  title           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user     User        @relation(fields: [id_user], references: [id_user], onDelete: Cascade)
  messages AIMessage[]

  @@index([id_user, updatedAt])
}

model AIMessage {
  id_message      String        @id @default(cuid())
  id_conversation String
  role            AIMessageRole
  content         String        @db.Text
  createdAt       DateTime      @default(now())

  conversation AIConversation @relation(fields: [id_conversation], references: [id_conversation], onDelete: Cascade)

  @@index([id_conversation, createdAt])
}

enum AIMessageRole {
  USER
  ASSISTANT
}

model AIUserMemory {
  id_memory String   @id @default(cuid())
  id_user   String
  key       String
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [id_user], references: [id_user], onDelete: Cascade)

  @@unique([id_user, key])
  @@index([id_user])
}
